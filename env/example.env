# /etc/zabbix/flashsystem/env
# Permisos: chmod 640, chown zabbix:zabbix
# NUNCA agregar a Git (.gitignore)

# --- SSH Authentication ---
# Opción A: SSH Key (recomendado para producción)
FS_USER=monitor
FS_KEYFILE=/etc/zabbix/ssh/flashsystem_key

# Opción B: Password (solo redes aisladas — comentar Opción A si usa esto)
# FS_USER=monitor
# FS_PASSWORD=your_password_here

# --- SSH Host Key Verification (Default Seguro para Producción) ---
FS_KNOWN_HOSTS=/etc/zabbix/ssh/known_hosts

# ADVERTENCIA: Usar FS_INSECURE=true únicamente para entornos de prueba o redes aisladas de laboratorio.
# FS_INSECURE=true

# --- Cache ---
FS_CACHE_DIR=/var/tmp
FS_METRICS_TTL=5m
FS_DISCOVERY_TTL=4h
FS_PERFORMANCE_TTL=1m
# FS_PERF_TTL=60s  # Alias legacy retrocompatible

# --- Logging ---
FS_VERBOSE=false
